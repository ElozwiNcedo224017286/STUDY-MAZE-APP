{
  "expo": {
    "name": "Study Maze",
    "slug": "study-maze",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/logo.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.studymaze.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#F6F4FB"
      },
      "package": "com.studymaze.app"
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
